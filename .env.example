# Supabase — keep the service role key on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: image search in the admin product editor (server only).
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Dedicated account for incoming 1C catalog exchange. Password: at least 24 chars.
ONEC_EXCHANGE_USER=onec_catalog
ONEC_EXCHANGE_PASSWORD=

# Private Supabase Storage buckets
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_REQUEST_BUCKET=request-documents
SUPABASE_HERO_BUCKET=hero-images

# Used by the future Plesk API layer; do not expose in browser JavaScript.
APP_BASE_URL=https://your-domain.kz

# Private Telegram channel; bot must be a channel admin with posting permission.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional absolute private path outside httpdocs.
TELEGRAM_QUEUE_PATH=
