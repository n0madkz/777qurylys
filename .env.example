# Supabase — keep the service role key on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage buckets
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_REQUEST_BUCKET=request-documents
SUPABASE_HERO_BUCKET=hero-images

# Used by the future Plesk API layer; do not expose in browser JavaScript.
APP_BASE_URL=https://your-domain.kz
